# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nextalk

# JWT - REQUIRED. App will fail to start if not set.
JWT_SECRET=change-this-to-a-secure-random-string-min-32-chars
JWT_REFRESH_SECRET=change-this-to-another-secure-random-string-min-32-chars

# Server
PORT=4000
NODE_ENV=development

# CORS - REQUIRED. App will fail to start if not set. Set to your frontend URL.
CORS_ORIGIN=http://localhost:5173

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
